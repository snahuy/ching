# Vercel frontend: public URL, NOT a secret. Set before building/redeploying.
VITE_MULTIPLAYER_URL=wss://YOUR-BACKEND.onrender.com/socket
# Backend only; do not prefix these with VITE_.
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/neondb?sslmode=verify-full
# Optional local SQLite alternative (omit when DATABASE_URL is set):
# ROOM_DB_PATH=.verification/rooms.sqlite
ALLOWED_ORIGINS=https://ching-nine.vercel.app
# PORT is provided by Render. Local development defaults to 3001.
